<?xml version="1.0"?>
<!-- Sample robot that uses mesh files: load it together with cube.stl and pyramid.dae -->
<robot name="mesh_robot">
  <material name="steel"><color rgba="0.55 0.6 0.65 1"/></material>
  <link name="base_link">
    <visual>
      <origin xyz="-0.1 -0.1 0"/>
      <geometry><mesh filename="package://demo_description/meshes/cube.stl" scale="0.2 0.2 0.1"/></geometry>
      <material name="steel"/>
    </visual>
  </link>
  <link name="mast">
    <visual><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.015" length="0.3"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual>
  </link>
  <link name="head">
    <visual><geometry><mesh filename="package://demo_description/meshes/pyramid.dae"/></geometry></visual>
  </link>
  <joint name="base_to_mast" type="fixed"><parent link="base_link"/><child link="mast"/><origin xyz="0 0 0.1"/></joint>
  <joint name="pan" type="continuous"><parent link="mast"/><child link="head"/>
    <origin xyz="0 0 0.3"/><axis xyz="0 0 1"/></joint>
</robot>
